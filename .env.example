# Copy to `.env` (git-ignored) and fill in what you have. Every variable is
# optional: a source without its credential is skipped and says so in the
# Data sources dialog, rather than failing the crawl.

# --- Reddit: switches the source on -------------------------------------
# robots.txt forbids crawling Reddit, so the official API is the only way in.
# Register: https://www.reddit.com/prefs/apps -> "create another app..."
#   type:         script
#   redirect uri: http://localhost:8080   (required, never used by a script app)
# CLIENT_ID is the string printed under the app name; SECRET is the "secret" field.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Udemy: switches the source on --------------------------------------
# Affiliate API only; robots.txt blocks /api-2.0/ and query-string URLs.
# Needs an approved Udemy affiliate account first, then request an API client:
#   https://www.udemy.com/affiliate/          (apply)
#   https://www.udemy.com/user/edit-api-clients/   (request client once approved)
# Approval is manual and is not always granted to new applicants.
UDEMY_CLIENT_ID=
UDEMY_CLIENT_SECRET=

# --- Stack Exchange: raises the quota, source works without it ----------
# Anonymous quota is 300 calls/day shared by the Stack Overflow and Stack
# Exchange crawlers; a key raises it to 10,000. Free and instant, no review.
# Register: https://stackapps.com/apps/oauth/register
# Use the "key" it issues (not the client id or secret).
STACK_APP_KEY=

# --- GitHub: raises the rate limit, source works without it -------------
# Search is limited per minute: 10 calls unauthenticated, 30 with a token.
# Any token works; public repository search needs no scopes at all.
# Create: https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=
