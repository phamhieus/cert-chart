# Copy to `.env` (git-ignored) and fill in what you have. Every key is optional:
# a source without its credential reports itself as skipped in the Data sources
# dialog rather than being scraped as a fallback.

# GitHub — raises the search rate limit from 10 to 30 requests per minute, which
# cuts the GitHub crawl from ~7 minutes to ~2 and stops terms failing with 403.
# Needs no scopes at all: a token with zero permissions still lifts the limit.
# https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# Stack Exchange — raises the daily quota from 300 to 10,000 requests. The
# crawler now spans four sites (stackoverflow, serverfault, security, pm), so a
# single run already uses most of the unauthenticated 300.
# Register an app, then use the "key" it issues (not the client secret):
# https://stackapps.com/apps/oauth/register
STACK_APP_KEY=

# Reddit — the source produces nothing without these. Reddit's robots.txt
# forbids scraping, so the official API is the only permitted route. Create a
# "script" app; the client id sits under the app name, the secret next to it.
# https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Udemy — the source produces nothing without these. Udemy's robots.txt
# disallows its API and every URL with a query string, so the Affiliate API is
# the only sanctioned route, and it requires being approved into the affiliate
# programme first (not instant).
# https://www.udemy.com/developers/affiliate/
UDEMY_CLIENT_ID=
UDEMY_CLIENT_SECRET=
