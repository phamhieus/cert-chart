{
  "name": "cert-chart",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Devvit app that counts IT certification mentions in the subreddit it is installed in",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "login": "devvit login",
    "dev": "devvit playtest",
    "build": "vite build",
    "type-check": "tsc --noEmit",
    "deploy": "npm run type-check && npm run test && devvit upload",
    "launch": "npm run deploy && devvit publish",
    "test": "vitest run"
  },
  "dependencies": {
    "@devvit/start": "0.14.5",
    "@devvit/web": "0.14.5",
    "@hono/node-server": "2.1.1",
    "devvit": "0.14.5",
    "hono": "4.13.7"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
